{
  "name": "borrower-portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/generate-env.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/generate-env.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/generate-env.mjs",
    "test": "ng test",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,html,css}\"",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@primeuix/themes": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "primeng": "^22.1.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.8"
  }
}
