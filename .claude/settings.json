{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-python.sh",
            "timeout": 60,
            "statusMessage": "ruff + mypy"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-frontend.sh",
            "timeout": 60,
            "statusMessage": "eslint"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(pytest *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)"
    ]
  }
}
