# Every variable the application reads. No values — DEP-018 keeps .env out of
# the repository, and DEP-023 sets the production ones with `fly secrets`.
#
# Copy to .env for local work: cp .env.example .env

# Where the SQLite file and the uploaded blobs live (DEP-003).
# DATABASE_URL is deliberately absent: core/config.py derives it from this as
# sqlite+aiosqlite:///${DATA_DIR}/app.db. Setting both would give one path two
# sources — change DATA_DIR and the database quietly stays where it was
# (DEP-051, CQ-081).
DATA_DIR=

# HS256 signing secret for the session cookie. At least 32 characters; startup
# fails loudly if it is missing or short, because a default secret in code is
# worse than no auth at all (AUTH-013, AUTH-017).
# Generate with: openssl rand -hex 32
JWT_SECRET=

# "development" or "production". Controls the cookie's Secure flag and nothing
# else (AUTH-018, AUTH-019).
ENVIRONMENT=

# OTLP collector endpoint. Left empty in production, where traces go to the
# console; set it to use the local LGTM stack via `make obs` (DEP-033).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional advisory document classification. Default off: with the flag off no
# client is constructed and the key below is never read, which is what lets the
# key be revoked without the deployed app degrading (AI-004, AI-024).
AI_CLASSIFICATION_ENABLED=false

# Only read when AI_CLASSIFICATION_ENABLED is true (DEP-024).
ANTHROPIC_API_KEY=
